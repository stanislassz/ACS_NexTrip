<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ACS_NexTrip.Models"
             xmlns:vm="clr-namespace:ACS_NexTrip.ViewModel"
             x:Class="ACS_NexTrip.Pages.HomePage"
             Shell.NavBarIsVisible="False"
             Title="HomePage">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header personnalisé -->
        <Border Grid.Row="0" 
            BackgroundColor="White"
            Padding="20,10">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Gray900}"
                    Offset="0,2"
                    Radius="8"
                    Opacity="0.1"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto, *, Auto" 
              ColumnSpacing="20"
              HeightRequest="60">

                <!-- Logo à gauche -->
                <HorizontalStackLayout Grid.Column="0" 
                                   Spacing="10" 
                                   VerticalOptions="Center">
                    <Border BackgroundColor="{StaticResource Orange500}"
                        HeightRequest="40"
                        WidthRequest="40"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label Text="NT" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="Orange"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    </Border>
                    <Label Text="NextTrip" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="Orange"
                       VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Boutons de navigation au centre -->
                <HorizontalStackLayout Grid.Column="1" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   Spacing="30">

                    <!-- Accueil actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="Accueil" 
                        TextColor="Orange" 
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2" Color="{StaticResource Orange500}" HorizontalOptions="Fill"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToDashboardCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                    <!-- Trajets actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5" Padding="10,0">
                        <Label Text="Trajets" 
                            TextColor="Orange" 
                            FontSize="14"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"/>

                        <BoxView HeightRequest="2" 
                                 Color="Transparent" 
                                 HorizontalOptions="Fill"/>

                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToTripsCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                    <!-- Utilisateurs actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="Utilisateurs" 
                                 TextColor="Orange" 
                                 FontSize="14"
                                 FontAttributes="Bold"
                                 HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2" Color="Transparent" HorizontalOptions="Fill"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToUsersCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>


                    <!-- Lieu actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="Lieu" 
                                TextColor="Orange" 
                                FontSize="14"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2" Color="Transparent" HorizontalOptions="Fill"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToLieuCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                    <!-- Paramètres actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="Paramètres" 
                        TextColor="Orange" 
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2" Color="Transparent" HorizontalOptions="Fill"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToSettingsCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                </HorizontalStackLayout>

            </Grid>
        </Border>

        <!-- Contenu principal -->
        <ScrollView Grid.Row="1" BackgroundColor="white">
            <VerticalStackLayout>

                <!-- Section avec le fond (jusqu'après les cartes) -->
                <Grid>
                    <Image Source="background_travel.jpg" Aspect="AspectFill" VerticalOptions="Fill" HorizontalOptions="Fill" />

                    <VerticalStackLayout Padding="30" Spacing="20">

                        <!-- Titre de la page -->
                        <Label Text="Où allez-vous ?" 
                           FontSize="32" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"/>

                        <!-- Section trajets récents -->
                        <VerticalStackLayout Spacing="15" Margin="0,0,0,20">
                            <Label Text="Prochains trajets" 
                                    FontSize="24" 
                                    FontAttributes="Bold"
                                    TextColor="Gray"/>
                        </VerticalStackLayout>

                        <!-- Liste des prochains trajets -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Trajets}" Spacing="15">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Trajet">
                                    <Border BackgroundColor="White" Padding="20">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="15"/>
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05"/>
                                        </Border.Shadow>

                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="20">

                                            <Border Grid.Column="0" BackgroundColor="#E3F2FD" HeightRequest="60" WidthRequest="60" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="30"/>
                                                </Border.StrokeShape>
                                                <Label Text="✈️" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                                                <HorizontalStackLayout Spacing="10">
                                                    <Label Text="{Binding TRA_LIEU_DEPART}" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                                                    <Label Text="➔" FontSize="18" TextColor="Orange" VerticalOptions="Center"/>
                                                    <Label Text="{Binding TRA_LIEU_ARRIVEE}" FontSize="18" FontAttributes="Bold" TextColor="Black"/>
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Spacing="15">
                                                    <HorizontalStackLayout Spacing="5">
                                                        <Label Text="📅" FontSize="12" VerticalOptions="Center"/>
                                                        <Label Text="{Binding TRA_DATEDEPART, StringFormat='{0:dd/MM/yyyy}'}" TextColor="{StaticResource Gray600}" FontSize="13" VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>
                                                    <HorizontalStackLayout Spacing="5">
                                                        <Label Text="🕒" FontSize="12" VerticalOptions="Center"/>
                                                        <Label Text="{Binding TRA_HEUREDEPART, StringFormat='{0:hh\\:mm}'}" TextColor="{StaticResource Gray600}" FontSize="13" VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>
                                                    <HorizontalStackLayout Spacing="5">
                                                        <Label Text="🏷️" FontSize="12" VerticalOptions="Center"/>
                                                        <Label Text="{Binding TYP_LIBELLE}" TextColor="{StaticResource Gray600}" FontSize="13" VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                                <Label Text="{Binding TRA_PRIX, StringFormat='{0:F2} €'}" 
                                FontSize="20" 
                                FontAttributes="Bold" 
                                TextColor="Orange"/>
                                                <Border BackgroundColor="#FFF3E0" Padding="8,2">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="5"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="Disponible" FontSize="10" TextColor="Orange" FontAttributes="Bold"/>
                                                </Border>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>