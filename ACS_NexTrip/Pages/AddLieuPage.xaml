<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ACS_NexTrip.ViewModel"
             x:Class="ACS_NexTrip.Pages.AddLieuPage"
             x:DataType="vm:AddLieuViewModel"
             Title="Ajouter un lieu"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">

            <Label Text="Nouveau Lieu"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   HorizontalOptions="Center" />

            <Label Text="📍" 
                   FontSize="60" 
                   HorizontalOptions="Center"
                   Margin="0,10,0,20"/>

            <VerticalStackLayout Spacing="8">
                <Label Text="Nom de la destination" 
                       TextColor="Gray" 
                       FontSize="14" 
                       Margin="5,0"/>

                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="#DDDDDD"
                        BackgroundColor="White"
                        Padding="15,5">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.05"/>
                    </Border.Shadow>

                    <Entry Text="{Binding Libelle}"
                           Placeholder="Ex: Paris, Lyon, Bureau..."
                           PlaceholderColor="Silver"
                           TextColor="Black"
                           FontSize="16" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="15" Margin="0,20,0,0">

                <Button Text="💾 Enregistrer"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="Orange"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="55"
                        CornerRadius="10">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,3" Radius="5" Opacity="0.2"/>
                    </Button.Shadow>
                </Button>

                <Button Text="Annuler"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Transparent"
                        TextColor="Gray"
                        HeightRequest="50" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>