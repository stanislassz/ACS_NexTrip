<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:ACS_NexTrip.ViewModel"
             x:DataType="viewmodel:EditTrajetViewModel"
             x:Class="ACS_NexTrip.Pages.EditTrajetPage"
             Title="Modifier le trajet">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Modifier les informations du trajet" 
                   FontSize="20" FontAttributes="Bold" 
                   HorizontalOptions="Center" Margin="0,0,0,10"/>

            <Label Text="Lieu de départ" FontAttributes="Bold"/>
            <Picker Title="Sélectionner le départ"
                    ItemsSource="{Binding Lieux}"
                    ItemDisplayBinding="{Binding LIE_LIBELLE}"
                    SelectedItem="{Binding SelectedDepart}" />

            <Label Text="Lieu d'arrivée" FontAttributes="Bold"/>
            <Picker Title="Sélectionner l'arrivée"
                    ItemsSource="{Binding Lieux}"
                    ItemDisplayBinding="{Binding LIE_LIBELLE}"
                    SelectedItem="{Binding SelectedArrivee}" />

            <Label Text="Type de transport" FontAttributes="Bold"/>
            <Picker Title="Moyen de transport"
                    ItemsSource="{Binding Types}"
                    ItemDisplayBinding="{Binding TYP_LIBELLE}"
                    SelectedItem="{Binding SelectedType}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Date" FontAttributes="Bold"/>
                    <DatePicker Date="{Binding DateDep}" Format="dd/MM/yyyy"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Heure" FontAttributes="Bold"/>
                    <TimePicker Time="{Binding HeureDep}" Format="HH:mm"/>
                </VerticalStackLayout>
            </Grid>

            <Label Text="Prix (€)" FontAttributes="Bold"/>
            <Entry Placeholder="Ex: 15.50" 
                   Keyboard="Numeric"
                   Text="{Binding Prix}"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0" 
                        Text="Annuler" 
                        Command="{Binding CancelCommand}"
                        BackgroundColor="Gray"
                        TextColor="White"/>

                <Button Grid.Column="1" 
                        Text="Enregistrer" 
                        Command="{Binding UpdateCommand}"
                        BackgroundColor="#2196F3"
                        TextColor="White"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>