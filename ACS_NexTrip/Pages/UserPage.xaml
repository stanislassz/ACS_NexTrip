<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ACS_NexTrip.Models"
             xmlns:vm="clr-namespace:ACS_NexTrip.ViewModel"
             x:Class="ACS_NexTrip.Pages.UserPage"
             Shell.NavBarIsVisible="False"
             Title="UserPage">
    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Header personnalisé -->
        <Border Grid.Row="0" 
            BackgroundColor="White"
            Padding="20,10">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Gray900}"
                    Offset="0,2"
                    Radius="8"
                    Opacity="0.1"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto, *, Auto" 
              ColumnSpacing="20"
              HeightRequest="60">

                <!-- Logo à gauche -->
                <HorizontalStackLayout Grid.Column="0" 
                                   Spacing="10" 
                                   VerticalOptions="Center">
                    <Border BackgroundColor="{StaticResource Orange500}"
                        HeightRequest="40"
                        WidthRequest="40"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label Text="TM" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="Orange"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    </Border>
                    <Label Text="TravelManager" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="Orange"
                       VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Boutons de navigation au centre -->
                <HorizontalStackLayout Grid.Column="1" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   Spacing="30">

                    <!-- Accueil actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="Accueil" 
                        TextColor="Orange" 
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToDashboardCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                    <!-- Trajets actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5" Padding="10,0">
                        <Label Text="Trajets" 
                            TextColor="Orange" 
                            FontSize="14"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"/>

                        <BoxView HeightRequest="2" 
                                 Color="Transparent" 
                                 HorizontalOptions="Fill"/>

                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToTripsCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                    <!-- Utilisateurs actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="Utilisateurs" 
                                 TextColor="Orange" 
                                 FontSize="14"
                                 FontAttributes="Bold"
                                 HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2" Color="{StaticResource Orange500}" HorizontalOptions="Fill"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToUsersCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>


                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="Lieu" 
                                TextColor="Orange" 
                                FontSize="14"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToLieuCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                    <!-- Utilisateurs actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="Paramètres" 
                        TextColor="Orange" 
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2" Color="Transparent" HorizontalOptions="Fill"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToUsersCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                </HorizontalStackLayout>

                <!-- Profil utilisateur à droite -->
                <HorizontalStackLayout Grid.Column="2" 
                                   Spacing="15" 
                                   VerticalOptions="Center">

                    <!-- Notifications -->
                    <Border BackgroundColor="White"
                        HeightRequest="40"
                        WidthRequest="40"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Label Text="🔔" 
                           FontSize="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowNotificationsCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Profil utilisateur -->
                    <Border BackgroundColor="Orange"
                        HeightRequest="45"
                        WidthRequest="45"
                        StrokeThickness="2"
                        Stroke="{StaticResource Orange300}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22.5"/>
                        </Border.StrokeShape>
                        <Label Text="JD" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="Black"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowProfileCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                </HorizontalStackLayout>

            </Grid>
        </Border>



    </Grid>
                
</ContentPage>