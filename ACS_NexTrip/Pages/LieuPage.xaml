<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ACS_NexTrip.ViewModel"
             xmlns:models="clr-namespace:ACS_NexTrip.Models"
             x:Class="ACS_NexTrip.Pages.LieuPage"
             x:DataType="vm:LieuViewModel"
             Title="Mes Destinations">

    <Grid RowDefinitions="Auto, *">

        <Button Grid.Row="0"
                Text="➕ Ajouter un nouveau lieu"
                Command="{Binding GoToAddLieuCommand}"
                Margin="20"
                CornerRadius="10"
                BackgroundColor="#2196F3"
                TextColor="White" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Lieux}"
                        Margin="10">

            <CollectionView.EmptyView>
                <Label Text="Aucun lieu enregistré." 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Lieu">
                    <Frame Margin="5,8" Padding="15" CornerRadius="12" HasShadow="True">
                        <Grid ColumnDefinitions="*, Auto">

                            <Label Grid.Column="0"
                                   Text="{Binding LIE_LIBELLE}"
                                   FontSize="18"
                                   VerticalOptions="Center" />

                            <ImageButton Grid.Column="1"
                                         Source="delete_icon.png"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LieuViewModel}}, Path=DeleteLieuCommand}"
                                         CommandParameter="{Binding .}"
                                         HeightRequest="25"
                                         BackgroundColor="Transparent" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>