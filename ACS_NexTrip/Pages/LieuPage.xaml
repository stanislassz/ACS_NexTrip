<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ACS_NexTrip.ViewModel"
             xmlns:models="clr-namespace:ACS_NexTrip.Models"
             x:Class="ACS_NexTrip.Pages.LieuPage"
             x:DataType="vm:LieuViewModel"
             BackgroundColor="#F5F5F5"
             >

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Header personnalisé -->
        <Border Grid.Row="0" 
                BackgroundColor="White"
                Padding="20,10">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Gray900}"
                        Offset="0,2"
                        Radius="8"
                        Opacity="0.1"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto, *, Auto" 
                  ColumnSpacing="20"
                  HeightRequest="60">

                <!-- Logo à gauche -->
                <HorizontalStackLayout Grid.Column="0" 
                           Spacing="10" 
                           VerticalOptions="Center">
                    <Border BackgroundColor="{StaticResource Orange500}"
                HeightRequest="40"
                WidthRequest="40"
                StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label Text="TM" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="Orange"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
                    </Border>
                    <Label Text="TravelManager" 
               FontSize="22" 
               FontAttributes="Bold" 
               TextColor="Orange"
               VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Boutons de navigation au centre -->
                <HorizontalStackLayout Grid.Column="1" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           Spacing="30">

                    <!-- Accueil actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="Accueil" 
                TextColor="Orange" 
                FontSize="14"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2" Color="Transparent" HorizontalOptions="Fill"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToDashboardCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                    <!-- Trajets actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5" Padding="10,0">
                        <Label Text="Trajets" 
                    TextColor="Orange" 
                    FontSize="14"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"/>

                        <BoxView HeightRequest="2" 
                         Color="Transparent" 
                         HorizontalOptions="Fill"/>

                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToTripsCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                    <!-- Utilisateurs actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="Utilisateurs" 
                         TextColor="Orange" 
                         FontSize="14"
                         FontAttributes="Bold"
                         HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2" Color="Transparent" HorizontalOptions="Fill"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToUsersCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>


                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="Lieu" 
                        TextColor="Orange" 
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2" Color="{StaticResource Orange500}" HorizontalOptions="Fill"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToLieuCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                    <!-- Utilisateurs actif -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="Paramètres" 
                TextColor="Orange" 
                FontSize="14"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>
                        <BoxView HeightRequest="2" Color="Transparent" HorizontalOptions="Fill"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToUsersCommand}"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                </HorizontalStackLayout>

                <!-- Profil utilisateur à droite -->
                <HorizontalStackLayout Grid.Column="2" 
                           Spacing="15" 
                           VerticalOptions="Center">

                    <!-- Notifications -->
                    <Border BackgroundColor="White"
                HeightRequest="40"
                WidthRequest="40"
                StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Label Text="🔔" 
                   FontSize="20"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowNotificationsCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Profil utilisateur -->
                    <Border BackgroundColor="Orange"
                HeightRequest="45"
                WidthRequest="45"
                StrokeThickness="2"
                Stroke="{StaticResource Orange300}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22.5"/>
                        </Border.StrokeShape>
                        <Label Text="JD" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   TextColor="Black"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowProfileCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Nom utilisateur -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="Jean Dupont" 
                   FontSize="14" 
                   FontAttributes="Bold"
                   TextColor="Black"/>
                        <Label Text="Administrateur" 
                   FontSize="11"
                   TextColor="Black"/>
                    </VerticalStackLayout>

                </HorizontalStackLayout>

            </Grid>
        </Border>


        <!-- Contenu principale -->
        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="10">
            <Label Text="Gestion des Lieux" 
                    FontSize="24" 
                    FontAttributes="Bold" 
                    TextColor="#333333"/>

            <Button Text="➕ Ajouter une destination"
                    Command="{Binding GoToAddLieuCommand}"
                    CornerRadius="8"
                    HeightRequest="50"
                    BackgroundColor="#2196F3"
                    FontAttributes="Bold"
                    TextColor="White">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.2" />
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding Lieux}"
                        Margin="15,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>


            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Lieu">
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            BackgroundColor="White"
                            Padding="15"
                            Margin="0,2">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="40, *, Auto">
                            <Label Grid.Column="0" Text="📍" VerticalOptions="Center" FontSize="18"/>

                            <Label Grid.Column="1"
                                   Text="{Binding LIE_LIBELLE}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#444444"
                                   VerticalOptions="Center" />

                            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">

                                <Button Text="📝"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LieuViewModel}}, Path=GoToEditCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="Black"
                                        Padding="0"
                                        WidthRequest="45"
                                        HeightRequest="45" />

                                <Button Text="🗑️"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LieuViewModel}}, Path=DeleteLieuCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        Padding="0"
                                        WidthRequest="40"
                                        HeightRequest="40" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>