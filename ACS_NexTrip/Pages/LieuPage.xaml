<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ACS_NexTrip.ViewModel"
             xmlns:models="clr-namespace:ACS_NexTrip.Models"
             x:Class="ACS_NexTrip.Pages.LieuPage"
             x:DataType="vm:LieuViewModel"
             BackgroundColor="#F5F5F5"
             Title="Mes Destinations">

    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="10">
            <Label Text="Gestion des Lieux" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#333333"/>

            <Button Text="➕ Ajouter une destination"
                    Command="{Binding GoToAddLieuCommand}"
                    CornerRadius="8"
                    HeightRequest="50"
                    BackgroundColor="#2196F3"
                    FontAttributes="Bold"
                    TextColor="White">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.2" />
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Lieux}"
                        Margin="15,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
  

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Lieu">
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            BackgroundColor="White"
                            Padding="15"
                            Margin="0,2">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="40, *, Auto">
                            <Label Grid.Column="0" Text="📍" VerticalOptions="Center" FontSize="18"/>

                            <Label Grid.Column="1"
                                   Text="{Binding LIE_LIBELLE}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#444444"
                                   VerticalOptions="Center" />

                            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">

                                <Button Text="📝"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LieuViewModel}}, Path=GoToEditCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="Black"
                                        Padding="0"
                                        WidthRequest="45"
                                        HeightRequest="45" />

                                <Button Text="🗑️"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LieuViewModel}}, Path=DeleteLieuCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        Padding="0"
                                        WidthRequest="40"
                                        HeightRequest="40" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>